# Variables de la API general. En producción viven en Railway (servicio API_Node.js_General).
# Copia este archivo a .env para correr en local y llena los valores.

# ── Firebase (CooApp: Firestore y notificaciones) ──
FB_PROJECT_ID=
FB_CLIENT_EMAIL=
FB_PRIVATE_KEY=
FS_COLLECTION=
FS_DOC=
EXPO_ACCESS_TOKEN=

# ── Google Sheets (CooApp: rutas /GetPendientes y /SavePendientes) ──
G_CLIENT_EMAIL=
G_PRIVATE_KEY=
G_PRIVATE_KEY_ID=
G_SCOPES=
G_FILE_ID_PENDIENTES=

# ── Comunidad Capital (/PaginaCapital) ──
# Postgres BD_Capital. En Railway: referencia ${{BD_Capital.DATABASE_URL}}
DATABASE_URL=
# Generar con: node scripts/capital-hash.js "contraseña"
CAPITAL_ADMIN_PASSWORD_HASH=
CAPITAL_JWT_SECRET=

PORT=4000
